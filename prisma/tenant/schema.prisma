generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma-tenant"
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

enum Role {
  ADMIN
  TECNICO
  RECEPCION
}

enum EstadoOrden {
  BORRADOR
  EN_PROCESO
  TERMINADA
  ENTREGADA
  ANULADA
}

enum EstadoCita {
  PROGRAMADA
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum TipoCombustible {
  GASOLINA
  DIESEL
  HIBRIDO
  ELECTRICO
}

enum TipoTransmision {
  AUTOMATICA
  MECANICA
}

enum MotivoRecordatorio {
  KILOMETRAJE
  TIEMPO
}

enum ResultadoNotificacionOrden {
  ENVIADA
  FALLO_ENVIO
}

model Usuario {
  id               String              @id @default(cuid())
  email            String              @unique
  passwordHash     String              @map("password_hash")
  nombre           String
  role             Role                @default(RECEPCION)
  historialEntries HistorialVehiculo[]
  ordenesCreadas   OrdenTrabajo[]      @relation("OrdenCreadoPor")
  ordenesAsignadas OrdenTrabajo[]      @relation("OrdenMecanico")
  manoDeObraAsignada ManoDeObra[]      @relation("ManoDeObraMecanico")
  dviRealizados    Dvi[]
  entradasCreadas  EntradaMercancia[]
  facturasEmitidas Factura[]
  pagosRegistrados Pago[]
  citasCreadas     Cita[]              @relation("CitaCreadoPor")
  cotizacionesCreadas Cotizacion[]     @relation("CotizacionCreadoPor")
  sedes            UsuarioSede[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@map("usuarios")
}

model Cliente {
  id                  String                     @id @default(cuid())
  nombre              String
  telefono            String?
  email               String?
  documento           String?
  vehiculos           Vehiculo[]
  ordenes             OrdenTrabajo[]
  facturas            Factura[]
  citas               Cita[]
  cotizaciones        Cotizacion[]
  recordatorios       RecordatorioEnviado[]
  notificacionesOrden NotificacionOrdenEnviada[]
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  @@map("clientes")
}

// Per-taller catalog (not shared across tenants -- see MarcaVehiculo). Vehiculo
// keeps its original free-text marca/modelo columns required and untouched in
// this phase; marcaId/modeloId are additive and nullable so existing rows and
// every current caller keep working unchanged until the UI phase actually
// writes them. Only once that path is proven does deprecating the free-text
// columns become safe.
model MarcaVehiculo {
  id        String           @id @default(cuid())
  nombre    String           @unique
  modelos   ModeloVehiculo[]
  vehiculos Vehiculo[]
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("marcas_vehiculo")
}

model ModeloVehiculo {
  id        String     @id @default(cuid())
  marcaId   String     @map("marca_id")
  marca     MarcaVehiculo @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  nombre    String
  vehiculos Vehiculo[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([marcaId, nombre])
  @@index([marcaId])
  @@map("modelos_vehiculo")
}

model Vehiculo {
  id                   String                @id @default(cuid())
  placa                String                @unique
  marca                String
  modelo               String
  marcaId              String?               @map("marca_id")
  marcaRef             MarcaVehiculo?        @relation(fields: [marcaId], references: [id], onDelete: Restrict)
  modeloId             String?               @map("modelo_id")
  modeloRef            ModeloVehiculo?       @relation(fields: [modeloId], references: [id], onDelete: Restrict)
  color                String?
  anio                 Int?
  combustible          TipoCombustible?
  kilometraje          Int?
  proximoMantenimiento DateTime?             @map("proximo_mantenimiento")
  transmision          TipoTransmision?
  observaciones        String?
  clienteId            String                @map("cliente_id")
  cliente              Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  historial            HistorialVehiculo[]
  ordenes              OrdenTrabajo[]
  citas                Cita[]
  cotizaciones         Cotizacion[]
  recordatorios        RecordatorioEnviado[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@index([clienteId])
  @@index([marcaId])
  @@index([modeloId])
  @@map("vehiculos")
}

model HistorialVehiculo {
  id          String   @id @default(cuid())
  vehiculoId  String   @map("vehiculo_id")
  vehiculo    Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  descripcion String
  fecha       DateTime @default(now())
  autorId     String?  @map("autor_id")
  autor       Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([vehiculoId])
  @@map("historial_vehiculo")
}

model Sede {
  id        String         @id @default(cuid())
  nombre    String
  direccion String?
  ordenes   OrdenTrabajo[]
  bodegas   Bodega[]
  usuarios  UsuarioSede[]
  citas     Cita[]
  cotizaciones Cotizacion[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("sedes")
}

/// Bridge table: which sedes a Usuario may work in. ADMIN bypasses this table
/// entirely (see src/lib/auth/sede-access.ts) -- rows here only ever matter for
/// TECNICO and RECEPCION. Composite PK, so the same grant can never be
/// duplicated and no surrogate id is needed.
model UsuarioSede {
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sedeId    String   @map("sede_id")
  sede      Sede     @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([usuarioId, sedeId])
  @@index([sedeId])
  @@map("usuario_sedes")
}

model OrdenTrabajo {
  id                 String                     @id @default(cuid())
  estado             EstadoOrden                @default(BORRADOR)
  clienteId          String                     @map("cliente_id")
  cliente            Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vehiculoId         String                     @map("vehiculo_id")
  vehiculo           Vehiculo                   @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  sedeId             String                     @map("sede_id")
  sede               Sede                       @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  mecanicoId         String?                    @map("mecanico_id")
  mecanico           Usuario?                   @relation("OrdenMecanico", fields: [mecanicoId], references: [id], onDelete: SetNull)
  creadoPorId        String                     @map("creado_por_id")
  creadoPor          Usuario                    @relation("OrdenCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  kilometrajeIngreso Int?                       @map("kilometraje_ingreso")
  sintomas           String?
  items              ItemOrden[]
  manoDeObra         ManoDeObra[]
  dvi                Dvi?
  factura            Factura?
  cotizacion         Cotizacion?
  notificaciones     NotificacionOrdenEnviada[]
  entregadaAt        DateTime?                  @map("entregada_at")
  anuladaAt          DateTime?                  @map("anulada_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@index([clienteId])
  @@index([vehiculoId])
  @@index([sedeId])
  @@index([estado])
  @@map("ordenes_trabajo")
}

model ItemOrden {
  id             String       @id @default(cuid())
  ordenId        String       @map("orden_id")
  orden          OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  repuestoId     String?      @map("repuesto_id")
  repuesto       Repuesto?    @relation(fields: [repuestoId], references: [id], onDelete: SetNull)
  descripcion    String
  cantidad       Int
  precioUnitario Decimal      @map("precio_unitario") @db.Decimal(10, 2)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([ordenId])
  @@index([repuestoId])
  @@map("items_orden")
}

model ManoDeObra {
  id          String       @id @default(cuid())
  ordenId     String       @map("orden_id")
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  descripcion String
  valor       Decimal      @db.Decimal(10, 2)
  // Distinto del mecanicoId de la orden (OrdenTrabajo.mecanicoId): cada tarea
  // puede quedar en manos de un técnico distinto al mecánico asignado en la
  // cabecera (p.ej. pastillas vs. correa de repartición).
  mecanicoId  String?      @map("mecanico_id")
  mecanico    Usuario?     @relation("ManoDeObraMecanico", fields: [mecanicoId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([ordenId])
  @@index([mecanicoId])
  @@map("mano_de_obra")
}

enum DviFotoMomento {
  ANTES
  DESPUES
}

model Dvi {
  id          String       @id @default(cuid())
  ordenId     String       @unique @map("orden_id")
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  checklist   Json         @default("{}")
  fotos       DviFoto[]
  creadoPorId String       @map("creado_por_id")
  creadoPor   Usuario      @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("dvi")
}

model DviFoto {
  id        String         @id @default(cuid())
  dviId     String         @map("dvi_id")
  dvi       Dvi            @relation(fields: [dviId], references: [id], onDelete: Cascade)
  momento   DviFotoMomento
  url       String
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([dviId])
  @@map("dvi_fotos")
}

model Bodega {
  id        String             @id @default(cuid())
  nombre    String
  sedeId    String             @map("sede_id")
  sede      Sede               @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  repuestos Repuesto[]
  entradas  EntradaMercancia[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@index([sedeId])
  @@map("bodegas")
}

model Proveedor {
  id        String             @id @default(cuid())
  nombre    String
  documento String?
  direccion String?
  contacto  String?
  telefono  String?
  email     String?
  repuestos Repuesto[]
  entradas  EntradaMercancia[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@map("proveedores")
}

model Repuesto {
  id           String                 @id @default(cuid())
  codigo       String                 @unique
  nombre       String
  descripcion  String?
  precioCompra Decimal                @map("precio_compra") @db.Decimal(10, 2)
  precioVenta  Decimal                @map("precio_venta") @db.Decimal(10, 2)
  stockActual  Int                    @default(0) @map("stock_actual")
  stockMinimo  Int                    @default(0) @map("stock_minimo")
  bodegaId     String                 @map("bodega_id")
  bodega       Bodega                 @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  proveedorId  String?                @map("proveedor_id")
  proveedor    Proveedor?             @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  entradaItems EntradaMercanciaItem[]
  itemsOrden   ItemOrden[]
  itemsCotizacion ItemCotizacion[]
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  @@index([bodegaId])
  @@index([proveedorId])
  @@map("repuestos")
}

model EntradaMercancia {
  id          String                 @id @default(cuid())
  proveedorId String                 @map("proveedor_id")
  proveedor   Proveedor              @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  bodegaId    String                 @map("bodega_id")
  bodega      Bodega                 @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  creadoPorId String                 @map("creado_por_id")
  creadoPor   Usuario                @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  items       EntradaMercanciaItem[]
  createdAt   DateTime               @default(now()) @map("created_at")

  @@index([proveedorId])
  @@index([bodegaId])
  @@map("entradas_mercancia")
}

model EntradaMercanciaItem {
  id                   String           @id @default(cuid())
  entradaId            String           @map("entrada_id")
  entrada              EntradaMercancia @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  repuestoId           String           @map("repuesto_id")
  repuesto             Repuesto         @relation(fields: [repuestoId], references: [id], onDelete: Restrict)
  cantidad             Int
  precioCompraUnitario Decimal          @map("precio_compra_unitario") @db.Decimal(10, 2)
  createdAt            DateTime         @default(now()) @map("created_at")

  @@index([entradaId])
  @@index([repuestoId])
  @@map("entrada_mercancia_items")
}

enum EstadoFactura {
  PENDIENTE
  PAGADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

model Factura {
  id             String        @id @default(cuid())
  numero         Int           @unique @default(autoincrement())
  estado         EstadoFactura @default(PENDIENTE)
  ordenId        String        @unique @map("orden_id")
  orden          OrdenTrabajo  @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  clienteId      String        @map("cliente_id")
  cliente        Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  subtotal       Decimal       @db.Decimal(10, 2)
  descuento      Decimal       @default(0) @db.Decimal(10, 2)
  iva            Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  saldoPendiente Decimal       @map("saldo_pendiente") @db.Decimal(10, 2)
  emitidaPorId   String        @map("emitida_por_id")
  emitidaPor     Usuario       @relation(fields: [emitidaPorId], references: [id], onDelete: Restrict)
  pagos          Pago[]
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([clienteId])
  @@index([estado])
  @@map("facturas")
}

model Pago {
  id              String     @id @default(cuid())
  facturaId       String     @map("factura_id")
  factura         Factura    @relation(fields: [facturaId], references: [id], onDelete: Restrict)
  monto           Decimal    @db.Decimal(10, 2)
  metodoPago      MetodoPago @map("metodo_pago")
  referencia      String?
  registradoPorId String     @map("registrado_por_id")
  registradoPor   Usuario    @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([facturaId])
  @@map("pagos")
}

/// A booked appointment. Staff-only in v1: RECEPCION/ADMIN book on behalf of a
/// customer who called or walked in — there is no public booking surface.
/// Carries its own sede_id (like OrdenTrabajo, unlike Repuesto) because an
/// appointment is made *at* a location; scopeCita() in src/lib/sede/scope.ts is
/// the single definition of that boundary.
model Cita {
  id          String     @id @default(cuid())
  clienteId   String     @map("cliente_id")
  cliente     Cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vehiculoId  String     @map("vehiculo_id")
  vehiculo    Vehiculo   @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  sedeId      String     @map("sede_id")
  sede        Sede       @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  fechaHora   DateTime   @map("fecha_hora")
  estado      EstadoCita @default(PROGRAMADA)
  motivo      String
  notas       String?
  creadoPorId String     @map("creado_por_id")
  creadoPor   Usuario    @relation("CitaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([sedeId])
  @@index([clienteId])
  @@index([vehiculoId])
  @@index([fechaHora])
  @@map("citas")
}

/// The tenant's own SMTP server. Exactly one row per tenant schema: the schema
/// IS the tenant boundary, so the id is a literal constant and the migration
/// adds a CHECK constraint enforcing it, making "at most one row" a database
/// invariant rather than an application convention.
///
/// password_cifrado is never plaintext: it is an AES-256-GCM envelope produced
/// by src/lib/crypto/secret-box.ts under the SMTP_ENCRYPTION_KEY master key.
model ConfiguracionSmtp {
  id              String   @id @default("singleton")
  host            String
  puerto          Int
  usuario         String
  passwordCifrado String   @map("password_cifrado")
  fromEmail       String   @map("from_email")
  fromNombre      String   @map("from_nombre")
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("configuracion_smtp")
}

/// One row per reminder email actually delivered. Doubles as the de-duplication
/// ledger: the reminder job skips any vehicle whose newest row here is younger
/// than COOLDOWN_RECORDATORIO_DIAS. A field on Vehiculo would answer only
/// "when"; this also records which address was mailed and which threshold
/// fired, and Fase 8's order-status notifications can reuse the same shape.
model RecordatorioEnviado {
  id           String             @id @default(cuid())
  vehiculoId   String             @map("vehiculo_id")
  vehiculo     Vehiculo           @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  clienteId    String             @map("cliente_id")
  cliente      Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  emailDestino String             @map("email_destino")
  motivo       MotivoRecordatorio
  enviadoAt    DateTime           @default(now()) @map("enviado_at")

  @@index([vehiculoId, enviadoAt])
  @@index([clienteId])
  @@map("recordatorios_enviados")
}

/// One row per order-status notification actually attempted and resolved
/// (sent or failed). Unlike RecordatorioEnviado there is no next cron sweep
/// to retry a failed send on -- the estado transition that triggers a
/// notification is a one-time event -- so the outcome must be recorded here
/// to be visible at all. Outcomes where nothing was attempted (no SMTP
/// configured, no client email on file) are surfaced immediately to the
/// staff member who changed the estado and are never written here -- see
/// the Fase 8 plan, Design decision 3.
model NotificacionOrdenEnviada {
  id           String                     @id @default(cuid())
  ordenId      String                     @map("orden_id")
  orden        OrdenTrabajo               @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  clienteId    String                     @map("cliente_id")
  cliente      Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  estado       EstadoOrden
  emailDestino String                     @map("email_destino")
  resultado    ResultadoNotificacionOrden
  enviadoAt    DateTime                   @default(now()) @map("enviado_at")

  @@index([ordenId, enviadoAt])
  @@index([clienteId])
  @@map("notificaciones_orden_enviadas")
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  RECHAZADA
  VENCIDA
}

enum TipoItemCotizacion {
  REPUESTO
  MANO_OBRA
}

/// A price quote given to a customer before work starts. Independent of
/// OrdenTrabajo (unlike Factura, which always closes one out): a Cotizacion
/// may never turn into an order, and ordenId is only set once staff approve it
/// and create the resulting OrdenTrabajo -- see EstadoCotizacion.APROBADA.
model Cotizacion {
  id           String             @id @default(cuid())
  numero       Int                @unique @default(autoincrement())
  estado       EstadoCotizacion   @default(BORRADOR)
  clienteId    String             @map("cliente_id")
  cliente      Cliente            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vehiculoId   String             @map("vehiculo_id")
  vehiculo     Vehiculo           @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  sedeId       String             @map("sede_id")
  sede         Sede               @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  motivo       String
  validaHasta  DateTime?          @map("valida_hasta")
  descuentoPct Decimal            @default(0) @map("descuento_pct") @db.Decimal(5, 2)
  subtotal     Decimal            @default(0) @db.Decimal(10, 2)
  descuento    Decimal            @default(0) @db.Decimal(10, 2)
  iva          Decimal            @default(0) @db.Decimal(10, 2)
  total        Decimal            @default(0) @db.Decimal(10, 2)
  notas        String?
  creadoPorId  String             @map("creado_por_id")
  creadoPor    Usuario            @relation("CotizacionCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  ordenId      String?            @unique @map("orden_id")
  orden        OrdenTrabajo?      @relation(fields: [ordenId], references: [id], onDelete: SetNull)
  items        ItemCotizacion[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@index([clienteId])
  @@index([vehiculoId])
  @@index([sedeId])
  @@index([estado])
  @@map("cotizaciones")
}

model ItemCotizacion {
  id             String             @id @default(cuid())
  cotizacionId   String             @map("cotizacion_id")
  cotizacion     Cotizacion         @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  tipo           TipoItemCotizacion
  repuestoId     String?            @map("repuesto_id")
  repuesto       Repuesto?          @relation(fields: [repuestoId], references: [id], onDelete: SetNull)
  descripcion    String
  cantidad       Decimal            @db.Decimal(6, 2)
  precioUnitario Decimal            @map("precio_unitario") @db.Decimal(10, 2)
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([cotizacionId])
  @@index([repuestoId])
  @@map("items_cotizacion")
}
